APP_NAME=VitoriaFinance
APP_ENV=development
APP_DEBUG=true
HTTP_PORT=8000
SECRET_KEY=troque-esta-chave-por-uma-chave-longa-e-aleatoria
DB_DRIVER=mysql+pymysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vitoria_finance
DB_USER=vitoria
DB_PASSWORD=troque-esta-senha
DB_CHARSET=utf8mb4
SESSION_HTTPS_ONLY=false
BOT_LOG_DIR=logs
# basic: inicializacao, encerramento, operacoes de escrita e erros.
# detailed: inclui mensagens do usuario, respostas da DeepInfra, ferramentas e resposta final.
BOT_LOG_LEVEL=basic
BOT_LOG_MAX_BYTES=10485760
BOT_LOG_BACKUP_COUNT=7
# Habilite somente depois de configurar e testar o token do Telegram.
BOT_SERVICE_ENABLED=false
